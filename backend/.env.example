# ---------------------------------------------------------------
# RCAi Configuration
# Copy this file to ".env" in the same folder and fill in your values
# ---------------------------------------------------------------

# Required for AI-generated Root Cause Analysis narratives.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Which Claude model to use for RCA generation
CLAUDE_MODEL=claude-sonnet-4-6

# Optional: AWS CloudWatch (leave blank to use demo/mock mode)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Optional: Site24x7 (leave blank to use demo/mock mode)
SITE24X7_API_KEY=
SITE24X7_ACCOUNT_ID=

# Flask
FLASK_PORT=5000
FLASK_DEBUG=True
